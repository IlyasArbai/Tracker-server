generator client {
    provider = "prisma-client"
    output   = "./generated"
}

datasource db {
    provider = "postgresql"
}

enum TrackType {
    Income
    Expense
}

model User {
    id       Int    @id @default(autoincrement())
    name     String
    email    String @unique
    password String

    tracks Track[]

    createdAt DateTime @default(now())
}

model Track {
    id Int @id @default(autoincrement())

    userId Int
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

    type   TrackType
    amount Int
    reason String

    createdAt DateTime @default(now())

    @@index([userId, createdAt])
}
